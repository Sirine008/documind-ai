# Copy to .env and adjust. Never commit .env.

# --- Docker Compose database (required for `docker compose up`) ---------------------
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Local (non-Docker) development ---------------------------------------------------
# Docker Compose builds this URL itself from the POSTGRES_* values above.
DOCUMIND_DATABASE_URL=postgresql+psycopg://documind:change-me-to-a-long-random-password@localhost:5432/documind
DOCUMIND_CORS_ORIGINS=http://localhost:5173

# --- Embeddings ----------------------------------------------------------------------------
# sentence-transformers (default, needs backend/requirements-ml.txt and a one-time model
# download) or hashing (offline, deterministic, lexical only — for tests and demos).
DOCUMIND_EMBEDDING_PROVIDER=sentence-transformers
DOCUMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCUMIND_EMBEDDING_DIM=384

# --- Answer generation --------------------------------------------------------------------
# mock      = demo mode, no API key; answers are sentences copied from retrieved passages
# openai    = any OpenAI-compatible /chat/completions API (OpenAI, Groq, Ollama, llama.cpp…)
# anthropic = Anthropic Messages API
DOCUMIND_LLM_PROVIDER=mock
DOCUMIND_LLM_MODEL=gpt-4o-mini
DOCUMIND_LLM_BASE_URL=https://api.openai.com/v1
DOCUMIND_LLM_API_KEY=
# Local model through Ollama (no key needed):
#   DOCUMIND_LLM_PROVIDER=openai
#   DOCUMIND_LLM_BASE_URL=http://localhost:11434/v1
#   DOCUMIND_LLM_MODEL=llama3.1:8b          # the README's real-model evaluation used llama3.2:3b
#   DOCUMIND_LLM_TIMEOUT_S=300              # CPU inference is slow (default 60)
# Optional cost estimate in the evaluation report (USD per 1,000 tokens):
# DOCUMIND_LLM_COST_PER_1K_INPUT=0.00015
# DOCUMIND_LLM_COST_PER_1K_OUTPUT=0.0006

# --- Tuning (defaults shown) ------------------------------------------------------------------
# DOCUMIND_CHUNK_SIZE=1000
# DOCUMIND_CHUNK_OVERLAP=150
# DOCUMIND_RETRIEVAL_MODE=hybrid          # hybrid | semantic | keyword
# DOCUMIND_RETRIEVAL_TOP_K=6
# DOCUMIND_RERANKER=lexical               # lexical | none
# DOCUMIND_MAX_UPLOAD_MB=20
# DOCUMIND_LOG_FORMAT=json                # json | text

# --- Docker build ---------------------------------------------------------------------------------
# INSTALL_ML=false builds a smaller backend image; then set DOCUMIND_EMBEDDING_PROVIDER=hashing.
INSTALL_ML=true
